# Copy to .env.local and fill in what you use. Never commit real values.
# Only names starting with NEXT_PUBLIC_ or VITE_ reach the browser; everything else is server/script-only.

# ── Accounts (Supabase) ────────────────────────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API. Accounts, gear, trips, personal trails and chat history live here.
# Only the public anon (publishable) key goes to the browser; row-level security limits every row to its owner.
# The static (Vite) app also accepts VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Server/CLI only: ingestion scripts and admin tools. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Applying migrations (Dashboard → Settings → Database → Connection string URI). Either name works.
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# SUPABASE_DB_URL=

# ── Site URL (sitemaps, robots.txt, canonical links, share links) ─────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Static sitemap and robots.txt (scripts/prepare-trail-assets.ts) use SITE_URL, then VITE_SITE_URL, then NEXT_PUBLIC_SITE_URL.
# SITE_URL=https://your-domain.com
# VITE_SITE_URL=https://your-domain.com

# ── Static app → hosted API (optional) ───────────────────────────────────────────────────────────────────
# The static app serves trails, features and the route builder from /trail-data by itself. Set this to send the
# remaining /api/* calls (directions, road connectors, product lookup) to a deployed Next.js server.
# VITE_HYKED_API_URL=https://api.your-domain.com
# Comma-separated origins allowed to call that server's /api/* from a browser (default: any origin).
# CORS_ORIGINS=https://your-domain.com

# ── Routing (OSRM-compatible) ───────────────────────────────────────────────────────────────────────────
# ROUTING_API_URL: driving directions (default: the OSRM public demo). ROUTING_FOOT_API_URL: the route builder's
# optional road connectors (default: FOSSGIS's public foot server). Both are for light use; set your own for production.
# ROUTING_API_URL=https://router.example.com
# ROUTING_FOOT_API_URL=https://router.example.com/foot

# ── Map tiles (optional overrides) ──────────────────────────────────────────────────────────────────────
# Raster tiles for the legacy catalog map views, and where OpenTrailMap styles are served from (no trailing slash).
# NEXT_PUBLIC_CATALOG_TILE_URL=https://tile.example.com/{z}/{x}/{y}.png
# NEXT_PUBLIC_CATALOG_TILE_ATTRIBUTION=© OpenStreetMap contributors
# NEXT_PUBLIC_OPENTRAILMAP_URL=https://your-cdn.example.com

# ── Search and lookups (optional, server only) ──────────────────────────────────────────────────────────
# Place search (Photon) and Overpass endpoints used by server routes and ingestion scripts.
# PHOTON_API_URL=https://photon.komoot.io
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# General web search for gear lookups on /plan.
BRAVE_SEARCH_API_KEY=
# OpenSkiMap API for ski-resort search.
NEXT_PUBLIC_SKI_API_URL=https://api.openskimap.org

# ── Admin ────────────────────────────────────────────────────────────────────────────────────────────────
# Simple secret gate for the admin dashboard on the Next.js server. Use a long random value in production.
ADMIN_SECRET=
