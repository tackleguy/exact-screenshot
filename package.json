{
  "name": "hyked",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-map-assets.mjs",
    "dev": "vite --config vite.config.ts",
    "dev:server": "next dev",
    "prebuild": "node scripts/prepare-map-assets.mjs",
    "build": "vite build --config vite.config.ts",
    "build:dev": "bun run build",
    "build:server": "node scripts/prepare-map-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/apply-migrations.ts",
    "ingest": "tsx scripts/ingestion/run.ts",
    "ingest:nps": "tsx scripts/ingestion/run.ts nps",
    "source:trails": "tsx scripts/ingestion/source-catalog.ts",
    "audit:trails": "tsx scripts/ingestion/audit-catalog.ts",
    "source:ski": "tsx scripts/ingestion/ski-runs.ts",
    "source:trailheads": "tsx scripts/ingestion/trailheads.ts",
    "verify:trails": "tsx scripts/ingestion/verify-osm.ts",
    "source:resorts": "tsx scripts/ingestion/resort-trails.ts",
    "source:towns": "tsx scripts/ingestion/towns.ts",
    "bootstrap": "tsx scripts/bootstrap-and-ingest.ts",
    "test": "tsx --test src/lib/ingestion/parsers/gpx.test.ts src/lib/assistant/*.test.ts src/lib/trail-catalog/*.test.ts src/lib/ingestion/*.test.ts src/lib/opentrailmap.test.ts src/lib/trip/*.test.ts src/lib/trail-difficulty.test.ts"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.10.0",
    "next": "^16.3.5",
    "pbf": "^4.0.2",
    "pngjs": "^7.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "pg": "^8.23.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^8.3.4"
  }
}
