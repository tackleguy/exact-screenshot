# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
# Accounts, gear, trips, personal trails and chat history are stored here. Only the public anon (publishable)
# key goes to the browser; row-level security limits every row to its owner.
# The static app also accepts VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# For CLI ingestion scripts (Supabase Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For applying migrations (Dashboard → Settings → Database → Connection string URI)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Production site URL for sitemap/SEO (optional locally)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# OpenTrailMap styles are self-hosted at /opentrailmap/* by default.
# Set this only if styles are served from another origin (no trailing slash).
# NEXT_PUBLIC_OPENTRAILMAP_URL=https://your-cdn.example.com

# OpenSkiMap API for resort search only (optional)
NEXT_PUBLIC_SKI_API_URL=https://api.openskimap.org

# Admin dashboard (Phase 1 — simple secret gate)
ADMIN_SECRET=change-me-in-production

# Optional general web search for /plan (server-only; no hosted AI inference)
BRAVE_SEARCH_API_KEY=

# Public API (used by the Hyked Lovable frontend)
# Comma-separated origins allowed to call /api/* from a browser; default is any origin.
# CORS_ORIGINS=https://your-hyked-app.lovable.app
# OSRM-compatible routing server for /api/directions (the public demo is for light use only).
# ROUTING_API_URL=https://router.example.com
